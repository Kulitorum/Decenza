+// This is enabled only for an extra stop-the-world mark after a mismatch. It
+// records the first observed discovery edge, not every possible retaining path.
+struct DiagnosticMarkTrace {
+    struct Edge { Heap::Base *parent; int rootStage; };
+    std::unordered_map<Heap::Base *, Edge> edges;
+    bool incomplete = false;
+    int drainDepth = 0;
+    static constexpr size_t limit = 200000;
+    void add(Heap::Base *object, Heap::Base *parent, int stage) {
+        if (!object || edges.find(object) != edges.end())
+            return;
+        if (edges.size() >= limit) { incomplete = true; return; }
+        edges.emplace(object, Edge{parent, stage});
+    }
+};
+thread_local DiagnosticMarkTrace *activeDiagnosticTrace = nullptr;
