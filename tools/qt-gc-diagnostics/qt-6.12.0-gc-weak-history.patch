+// Original incremental weak visits only. Full validation/tracing must not
+// overwrite the evidence they are intended to explain.
+struct DiagnosticWeakHistory {
+    struct Visit {
+        quintptr qobject = 0;
+        quintptr topParent = 0;
+        unsigned objectFlags = 0;
+        unsigned topFlags = 0;
+        bool keepAlive = false;
+        bool markedBefore = false;
+        bool markedAfter = false;
+        unsigned visits = 0;
+    };
+    std::unordered_map<Heap::Base *, Visit> visits;
+    bool remarking = false;
+    bool incomplete = false;
+    static constexpr size_t limit = 200000;
+};
+thread_local std::unordered_map<MemoryManager *, DiagnosticWeakHistory> diagnosticWeakHistories;
+
+unsigned diagnosticOwnershipFlags(QObject *object)
+{
+    auto *data = QQmlData::get(object, false);
+    // Bit 0: data exists, bit 1: C++ ownership, bit 2: root in creation.
+    return data ? 1u | (data->indestructible ? 2u : 0u)
+                        | (data->rootObjectInCreation ? 4u : 0u) : 0u;
+}
+
+void beginDiagnosticWeakHistory(GCStateMachine *gc)
+{
+    if (!gc->mm->crossValidateIncrementalGC || gc->mm->aggressiveGC
+            || gc->timeLimit.count() <= 0) {
+        diagnosticWeakHistories.erase(gc->mm);
+        return;
+    }
+    auto &history = diagnosticWeakHistories[gc->mm];
+    if (!history.remarking) {
+        history.visits.clear();
+        history.incomplete = false;
+    }
+}
+
+void recordDiagnosticWeakVisit(GCStateMachine *gc, QObjectWrapper *wrapper,
+                               QObject *object, bool keepAlive, bool markedBefore)
+{
+    auto found = diagnosticWeakHistories.find(gc->mm);
+    if (found == diagnosticWeakHistories.end() || found->second.remarking)
+        return;
+    auto &history = found->second;
+    auto prior = history.visits.find(wrapper->d());
+    if (prior == history.visits.end() && history.visits.size() >= history.limit) {
+        history.incomplete = true;
+        return;
+    }
+    QObject *top = object;
+    while (top->parent())
+        top = top->parent();
+    auto &visit = history.visits[wrapper->d()];
+    ++visit.visits;
+    visit.qobject = quintptr(object);
+    visit.topParent = quintptr(top);
+    visit.objectFlags = diagnosticOwnershipFlags(object);
+    visit.topFlags = diagnosticOwnershipFlags(top);
+    visit.keepAlive = keepAlive;
+    visit.markedBefore = markedBefore;
+    visit.markedAfter = wrapper->markBit();
+}
