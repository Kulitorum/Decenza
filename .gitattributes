# A CR left on a line would make scripts/qt_modules.sh misread the module list.
*.sh                    text eol=lf
.github/qt-modules.txt  text eol=lf

# Its bytes are hashed into the web package identity (cmake/wasm_package_identity.cmake),
# so a CRLF checkout would give Windows a different identity for the same tree.
qt-version.txt          text eol=lf
