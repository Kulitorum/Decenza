// Native-owned actions used by the shared post-shot review page.
class ShotReviewActionState
{
    PROP(bool visualizerUploading READONLY)
    PROP(bool decentUploading READONLY)
    PROP(qint64 decentLastShotId READONLY)
    PROP(int decentLastHttpStatus READONLY)
    PROP(QString decentLastSerial READONLY)
    PROP(QString decentResultCode READONLY)
    PROP(QString visualizerLastUploadStatus READONLY)
    PROP(int decentUploadedResult READONLY)
    PROP(bool visualizerActive READONLY)
    PROP(bool decentActive READONLY)
    PROP(bool aiConfigured READONLY)
    PROP(bool aiAnalyzing READONLY)
    PROP(QString discussShotUrl READONLY)
    PROP(bool discussReady READONLY)
    PROP(bool discussEnabled READONLY)
    PROP(bool mcpEnabled READONLY)
    PROP(bool refractometerConfigured READONLY)
    PROP(bool refractometerConnected READONLY)
    PROP(bool refractometerMeasuring READONLY)
    PROP(double refractometerTds READONLY)
    PROP(double refractometerTemperature READONLY)
    PROP(QString refractometerName READONLY)
    PROP(QString savedRefractometerAddress READONLY)
    PROP(QString savedRefractometerName READONLY)

    SLOT(void execute(QString requestId, QString operation, QVariantMap arguments))
    SIGNAL(actionCompleted(QString requestId, QString operation, bool success, QVariantMap result, QString reason))
    SIGNAL(visualizerUploadSucceeded(qint64 shotId, QString visualizerId, QString url))
    SIGNAL(savedShotFinished(qint64 shotId, QString error, QString skipReason))
    SIGNAL(decentUploadFinished(qint64 shotId, int result))
    SIGNAL(refractometerMeasurementComplete())
    SIGNAL(refractometerAverageProgress(int completed, int total))
}
