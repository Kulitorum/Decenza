// Shared screensaver playback transport. File paths stay in the native
// manager; paired clients receive only opaque media tickets.
class ScreensaverState
{
    PROP(bool ready READONLY)
    PROP(bool screensaverActive READONLY)
    PROP(bool enabled READONLY)
    PROP(QString screensaverType READONLY)
    PROP(int imageDisplayDuration READONLY)
    PROP(int dimPercent READONLY)
    PROP(int dimDelayMinutes READONLY)
    PROP(bool videosShowClock READONLY)
    PROP(bool pipesShowClock READONLY)
    PROP(bool attractorShowClock READONLY)
    PROP(double pipesSpeed READONLY)
    PROP(double pipesCameraSpeed READONLY)
    PROP(bool flipClockUse3D READONLY)
    PROP(QString shotMapShape READONLY)
    PROP(QString shotMapTexture READONLY)
    PROP(bool shotMapShowClock READONLY)
    PROP(bool shotMapShowProfiles READONLY)
    PROP(bool shotMapShowTerminator READONLY)
    PROP(bool overlayShowWaterLevel READONLY)
    PROP(bool overlayShowShotPlan READONLY)
    PROP(bool overlayShowBattery READONLY)
    PROP(bool overlayLinkButtonEnabled READONLY)
    PROP(QString overlayLinkButtonLabel READONLY)
    PROP(QString overlayLinkButtonUrl READONLY)
    PROP(bool showDateOnPersonal READONLY)
    PROP(bool isPersonalCategory READONLY)
    PROP(int itemCount READONLY)
    PROP(bool isDownloading READONLY)
    PROP(double downloadProgress READONLY)
    PROP(int personalMediaCount READONLY)
    PROP(QVariantList categories READONLY)
    PROP(QString selectedCategoryId READONLY)
    PROP(QString selectedCategoryName READONLY)
    PROP(bool isFetchingCategories READONLY)
    PROP(bool isRefreshing READONLY)
    PROP(qint64 cacheUsedBytes READONLY)
    PROP(bool isRateLimited READONLY)
    PROP(int rateLimitMinutesRemaining READONLY)
    PROP(QString operationError READONLY)
    PROP(QVariantMap shotMapData READONLY)

    SLOT(void execute(QString requestId, QString operation, QString ticket))
    SLOT(void importMedia(QString requestId, QString transferId, QString clientId))
    SLOT(void cancelMediaImport(QString requestId, QString targetRequestId, QString clientId))

    SIGNAL(operationCompleted(QString requestId, QString operation, bool success,
                              QVariantMap result, QString reason))
    SIGNAL(mediaAvailable())
}
